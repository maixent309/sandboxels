// === Light Water ===
elements.light_water = {
    color: "#88cfff",
    behavior: behaviors.LIQUID,
    category: "liquids",
    state: "liquid",
    density: 1000,
    tempHigh: 100,
    stateHigh: "steam",
    reactions: {
        uranium: { elem1: "light_water_radioactive", elem2: null },
        plutonium: { elem1: "light_water_radioactive", elem2: null },
    }
};

elements.light_water_radioactive = {
    color: "#00ffcc",
    behavior: behaviors.LIQUID,
    category: "liquids",
    state: "liquid",
    density: 1000,
    tempHigh: 100,
    stateHigh: "radioactive_steam",
    tick: function(pixel) {
        if (Math.random() < 0.01) {
            pixel.color = pixelColorPick(pixel, "#00ffcc");
        }
    }
};

